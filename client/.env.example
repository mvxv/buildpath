# Supabase → Project Settings → API. The anon key is designed to be public and is
# safe in the browser bundle. Never put the service role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Base URL of the BuildPath API.
VITE_API_URL=http://localhost:5000
