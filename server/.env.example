# Supabase → Project Settings → Database → Connection string → URI
# Remember to URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

PORT=5000

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Comma-separated list of browser origins allowed to call this API.
# Local Vite dev server is always allowed; add your deployed frontend here.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
